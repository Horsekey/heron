#!/usr/bin/env bash
# heron - bait fishing with deception canaries
#
#   ./heron init [file]     provision bait accounts from heron.yaml
#   ./heron watch           poll them; exit 1 = DETECTED, 2 = nothing watching
#   ./heron secrets <repo>  upload the fleet to a private repo as an Actions secret
#
#   $HERON_HOME/fleet   "repo<TAB>token<TAB>login[<TAB>deploy-only]"
#   $HERON_HOME/state/  counters between runs
#
# Using a bait token burns its rate limit. git doesn't.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

HERON_HOME=${HERON_HOME:-$HOME/.heron}
FLEET=$HERON_HOME/fleet
STATE=$HERON_HOME/state
RC=0

report() {
  local level=$1 label=$2 message=$3
  if [[ $level == ALERT ]]; then
    RC=1
  fi
  printf '%-5s %s: %s\n' "$level" "$label" "$message"
}

# no comments or blanks
entries() {
  grep -vE '^[[:space:]]*(#|$)' "$FLEET"
}

poll() {
  local token=$1 url=$2 headers code
  shift 2
  headers=$(mktemp)
  code=$(curl -s -o /dev/null -D "$headers" -w '%{http_code}' --max-time 30 \
           -H "Authorization: Bearer $token" "$@" "$url")
  awk -v code="$code" '
    tolower($1) == "x-ratelimit-used:"  { used  = $2 + 0 }
    tolower($1) == "x-ratelimit-reset:" { reset = $2 + 0 }
    END { print code, used + 0, reset + 0 }
  ' "$headers"
  rm -f "$headers"
}

# alerts if used > our calls. Sets NEW to the state to save.
counter() {
  local label=$1 ours=$2 prev=$3 code=$4 used=$5 reset=$6
  local prev_reset=${prev% *} prev_spend=${prev#* } spend

  case $code in
    200) ;;
    401|403)
      # alert once not every run
      if [[ $prev_reset == REVOKED ]]; then
        report WARN "$label" "HTTP $code - still dead, re-provision or drop it from the fleet"
      else
        report ALERT "$label" "HTTP $code - revoked, expired, or suspended"
      fi
      NEW="REVOKED 0"
      return
      ;;
    *)
      report WARN "$label" "HTTP $code"
      NEW=$prev
      return
      ;;
  esac

  # first run, or a revoked bait is back
  if [[ -z $prev_reset || $prev_reset == REVOKED ]]; then
    report BASE "$label" "cold start baseline used=$used"
    NEW="$reset $used"
    return
  fi

  # same window = add to last total
  if [[ $reset == "$prev_reset" ]]; then
    spend=$((prev_spend + ours))
  else
    spend=$ours
  fi

  if (( used > spend )); then
    report ALERT "$label" "$((used - spend)) call(s) we did not make (used=$used, ours=$spend)"
    NEW="$reset $used"   # only alert once
  else
    report OK "$label" "used=$used (all ours)"
    NEW="$reset $spend"
  fi
}

clones() {
  local token=$1 repo=$2 label=$3 state_file=$4 fresh new

  # "YYYY-MM-DD <count>" per day
  fresh=$(curl -s --max-time 30 -H "Authorization: Bearer $token" \
            "https://api.github.com/repos/$repo/traffic/clones" \
          | jq -r '.clones[]? | "\(.timestamp[0:10]) \(.count)"')
  if [[ -z $fresh ]]; then
    report WARN "$label" "no traffic data - push access?"
    return
  fi

  if [[ -f $state_file ]]; then
    new=$(awk -v state_file="$state_file" '
      BEGIN { while ((getline line < state_file) > 0) { split(line, f, " "); seen[f[1]] = f[2] } }
      { before = ($1 in seen) ? seen[$1] : 0; if ($2 > before) n += $2 - before }
      END { print n + 0 }
    ' <<<"$fresh")
    if (( new > 0 )); then
      report ALERT "$label" "$new new clone(s) of $repo"
    else
      report OK "$label" "no new clones"
    fi
  else
    report BASE "$label" "cold start recording clone counts"
  fi
  printf '%s\n' "$fresh" > "$state_file"
}

watch() {
  local repo token login state_file core_prev gql_prev dupes NEW

  if [[ ! -s $FLEET ]]; then
    echo "nothing to watch - run './heron init'" >&2
    return 2
  fi
  mkdir -p "$STATE"

  # baits sharing an account would flag each other's polls
  dupes=$(entries | awk -F'\t' '
    $3 != "" { count[$3]++ }
    END { for (a in count) if (count[a] > 1) printf "%s (%d) ", a, count[a] }
  ')
  if [[ -n $dupes ]]; then
    echo "ERROR: baits share an account: $dupes" >&2
    return 2
  fi

  while IFS=$'\t' read -r repo token login _; do
    state_file=$STATE/${repo//\//_}

    if [[ -z ${token:-} ]]; then
      report WARN "$repo" "no token in the fleet - skipped"
      continue
    fi

    core_prev="" gql_prev=""
    [[ -f $state_file.core ]] && core_prev=$(< "$state_file.core")
    [[ -f $state_file.graphql ]] && gql_prev=$(< "$state_file.graphql")

    # /traffic/clones doesn't cost rate limit
    if [[ -n ${login:-} ]]; then
      clones "$token" "$login/$repo" "$repo [clones]" "$state_file.clones"
    fi

    # unquoted poll splits into counter's last 3 args. /user costs us 1 core call.
    counter "$repo [core]" 1 "$core_prev" \
      $(poll "$token" https://api.github.com/user -H "Accept: application/vnd.github+json")
    printf '%s\n' "$NEW" > "$state_file.core"

    # graphql has its own limit; {rateLimit} polls are free, so ours=0
    counter "$repo [graphql]" 0 "$gql_prev" \
      $(poll "$token" https://api.github.com/graphql -X POST -d '{"query":"{rateLimit{used}}"}')
    printf '%s\n' "$NEW" > "$state_file.graphql"
  done < <(entries)

  return $RC
}

# HERON_YES=1 bypasses
confirm() {
  local answer
  [[ ${HERON_YES:-} == 1 ]] && return 0
  [[ -t 0 ]] || return 1
  read -r -p "  $1 (y/N): " answer </dev/tty || true
  [[ $answer == [Yy]* ]]
}

init() {
  local cfg=${1:-heron.yaml} out=$HERON_HOME/out c py tmp rc=0

  for c in curl jq ssh-keygen gh; do
    command -v "$c" >/dev/null || { echo "  MISSING  $c" >&2; return 1; }
  done
  for py in python3 .venv/bin/python ''; do
    [[ -n $py ]] && "$py" -c 'import playwright, yaml' 2>/dev/null && break
  done
  [[ -n $py ]] || { echo "  MISSING  playwright + pyyaml: pip install playwright pyyaml && playwright install chromium" >&2; return 1; }
  [[ -f $cfg ]] || { echo "no $cfg - copy heron.yaml.example"; return 0; }

  mkdir -p "$HERON_HOME" "$out" && chmod 700 "$HERON_HOME" "$out"
  if [[ -s $FLEET ]] && ! confirm "$FLEET exists - re-provision"; then
    echo "  keeping it"
    return 0
  fi

  echo "  Bait accounts must be accounts nobody ever logs into:"
  echo "  the counter is per account, so your own traffic reads as an intruder."
  echo

  # provision.py prints one fleet line per bait
  tmp=$(mktemp)
  "$py" lib/provision.py "$cfg" "$out" .pw-bait- > "$tmp" || rc=$?

  # keep tokens minted before a failure
  if [[ ! -s $tmp ]]; then
    echo "  no tokens minted" >&2
    rm -f "$tmp"
    return 1
  fi
  if (( rc )); then
    echo "  WARNING: stopped early - keeping the $(grep -c . "$tmp") token(s) already minted" >&2
  fi

  mv "$tmp" "$FLEET"
  chmod 600 "$FLEET"

  echo
  echo "  fleet  $FLEET  ($(grep -c . "$FLEET") bait token(s))"
  echo "  keys   $out/   (deploy-key private halves)"
  echo
  awk -F'\t' '$4 != "deploy-only" { printf "    plant %-20s %s\n", $1, $2 }' "$FLEET"
  echo
  echo "  next: ./heron watch     then    ./heron secrets <you>/<private-repo>"
}

secrets() {
  local repo=${1:-$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)} visibility

  if [[ -z $repo ]]; then
    echo "usage: ./heron secrets <owner/repo>" >&2
    return 1
  fi
  if [[ ! -s $FLEET ]]; then
    echo "no fleet - run ./heron init first" >&2
    return 1
  fi

  visibility=$(gh repo view "$repo" --json visibility -q .visibility 2>/dev/null || echo UNKNOWN)
  if [[ $visibility == PUBLIC ]]; then
    echo "REFUSING: $repo is PUBLIC - bait credentials would be secrets there, and a" >&2
    echo "detection opens an issue naming which bait fired. Use a private repo." >&2
    return 1
  fi

  if ! confirm "upload bait credentials to $repo"; then
    echo "  aborted"
    return 1
  fi
  gh secret set HERON_FLEET --repo "$repo" < "$FLEET" || return 1
  echo "  set HERON_FLEET"
  echo "  scheduled workflows run only on the default branch, and are disabled"
  echo "  after 60 days of repo inactivity. Check: gh workflow list --repo $repo"
}

case ${1:-} in
  init)    init "${2:-}" ;;
  watch)   watch ;;
  secrets) secrets "${2:-}" ;;
  ""|-h|--help)
    [[ -f heron.art ]] && sed 's/[[:space:]]*$//' heron.art
    echo

    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
    ;;
  *)
    echo "unknown command: $1" >&2
    exit 1
    ;;
esac
